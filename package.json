{
  "name": "tscore-monorepo",
  "version": "0.6.0",
  "private": true,
  "description": "tScore: open-source scoring for motorcycle trials, with punched-card scanning.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run dev -w apps/desktop",
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dist": "npm run dist -w apps/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:schemas": "node scripts/gen-schemas.mjs --check",
    "gen:errors": "node scripts/gen-errors.mjs",
    "check:errors": "node scripts/gen-errors.mjs --check",
    "check": "npm run check:schemas && npm run check:errors && npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:e2e": "npm run test:e2e -w apps/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
