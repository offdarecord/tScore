{
  "schema": "tscore.import_mapping/1",
  "id": "tscore-rider-list",
  "name": "tScore rider list",
  "detect": { "headers": ["Given name", "Family name", "Class"] },
  "columns": {
    "given_name": ["Given name"],
    "family_name": ["Family name"],
    "class": ["Class"],
    "club": ["Club"],
    "licence": ["Licence"],
    "number": ["Number"],
    "competition_status": ["Competition status", "Tier"]
  },
  "competition_status_rules": [
    {
      "field": "competition_status",
      "in": ["NC", "Non-competitive", "Non competitive"],
      "competition_status": "non_competitive"
    },
    {
      "field": "competition_status",
      "in": ["NA", "No award", "No-award"],
      "competition_status": "no_award"
    }
  ],
  "keep_numbers": true
}
