{
  "name": "tscore",
  "productName": "tScore",
  "version": "0.8.0",
  "private": true,
  "description": "Scoring for motorcycle trials, with punched-card scanning.",
  "author": "tScore contributors",
  "homepage": "https://github.com/offdarecord/tScore",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "test:e2e": "electron-vite build && playwright test",
    "screenshots": "electron-vite build && playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "i18next": "27.1.1",
    "react-i18next": "18.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@playwright/test": "^1.65.1",
    "@tscore/core": "*",
    "@tscore/store": "*",
    "@tscore/vision": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.3.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
